{
  "deployment": {
    "environment": "mainnet",
    "contract_address": "0x153dDf13D58397740c40E9D1a6e183A8c0F36c32",
    "rpc_url": "${MAINNET_RPC_URL:-https://mainnet.infura.io/v3/${INFURA_PROJECT_ID}}"
  },
  "wallet": {
    "address": "0xaCd9a5B2438EF62bc7b725c574cDb23bf8D0314D",
    "private_key_env_var": "PRODUCTION_PRIVATE_KEY"
  },
  "arbitrage": {
    "min_profit_usd": 10.0,
    "max_trade_size_usd": 1000.0,
    "gas_limit": 500000,
    "slippage_tolerance": 0.025
  },
  "risk_management": {
    "max_daily_trades": 100,
    "max_daily_loss": 1000.0,
    "max_position_size": 10000.0
  },
  "logging": {
    "level": "INFO",
    "file_path": "${LOG_DIR:-./logs}/production.log"
  }
}