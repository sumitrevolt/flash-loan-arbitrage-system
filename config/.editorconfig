# Configuration directory - JSON and JavaScript only
root = false

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

[*.json]
indent_size = 2

[*.js]
indent_size = 2

# No TypeScript files in this directory
[*.ts]
# This directory should not contain TypeScript files 