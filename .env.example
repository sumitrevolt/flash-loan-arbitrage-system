# Flash Loan Arbitrage System Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# ENVIRONMENT SETTINGS
# =============================================================================
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# =============================================================================
# BLOCKCHAIN RPC ENDPOINTS
# =============================================================================
# Polygon
POLYGON_RPC_URL=https://polygon-rpc.com/
POLYGON_TESTNET_RPC_URL=https://rpc-mumbai.maticvigil.com/

# Ethereum
ETHEREUM_RPC_URL=https://eth-mainnet.alchemyapi.io/v2/YOUR_API_KEY
ETHEREUM_TESTNET_RPC_URL=https://eth-goerli.alchemyapi.io/v2/YOUR_API_KEY

# Binance Smart Chain
BSC_RPC_URL=https://bsc-dataseed.binance.org/
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/

# Arbitrum
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ARBITRUM_TESTNET_RPC_URL=https://goerli-rollup.arbitrum.io/rpc

# =============================================================================
# WALLET CONFIGURATION
# =============================================================================
# IMPORTANT: Never commit your actual private key to version control!
PRIVATE_KEY=your_wallet_private_key_here
WALLET_ADDRESS=your_wallet_address_here

# =============================================================================
# API KEYS
# =============================================================================
# Price data APIs
COINGECKO_API_KEY=your_coingecko_api_key
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key

# Blockchain explorers
ETHERSCAN_API_KEY=your_etherscan_api_key
POLYGONSCAN_API_KEY=your_polygonscan_api_key
BSCSCAN_API_KEY=your_bscscan_api_key
ARBISCAN_API_KEY=your_arbiscan_api_key

# DEX APIs
DEXGURU_API_KEY=your_dexguru_api_key
MORALIS_API_KEY=your_moralis_api_key

# =============================================================================
# TRADING PARAMETERS
# =============================================================================
# Risk management
MAX_TRADE_SIZE_USD=10000
MIN_PROFIT_USD=5
SLIPPAGE_TOLERANCE=0.005
MAX_CONCURRENT_TRADES=3
RISK_TOLERANCE=0.1

# Execution settings
AUTO_EXECUTE=false
GAS_PRICE_GWEI=20
MAX_GAS_LIMIT=500000

# =============================================================================
# MCP SERVER CONFIGURATION
# =============================================================================
MCP_BASE_PORT=8000
MCP_HEALTH_CHECK_INTERVAL=30
MCP_TIMEOUT_SECONDS=10

# =============================================================================
# AI AGENT CONFIGURATION
# =============================================================================
AI_MODEL_PATH=models/
AI_PREDICTION_INTERVAL=60
AI_TRAINING_ENABLED=false
AI_CONFIDENCE_THRESHOLD=0.7
AI_LEARNING_RATE=0.001

# =============================================================================
# MONITORING & ALERTS
# =============================================================================
# Discord notifications
DISCORD_WEBHOOK=https://discord.com/api/webhooks/YOUR_WEBHOOK_URL
ENABLE_DISCORD_ALERTS=false

# Email notifications
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
ENABLE_EMAIL_ALERTS=false

# Prometheus monitoring
ENABLE_PROMETHEUS=true
PROMETHEUS_PORT=9090

# Alert thresholds
MAX_LOSS_USD=1000
MIN_SUCCESS_RATE=0.8
MAX_RESPONSE_TIME_MS=2000

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/flashloan_db
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# AWS (if using cloud features)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# Telegram bot (optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Development features
ENABLE_TEST_MODE=false
MOCK_BLOCKCHAIN_CALLS=false
USE_TESTNET=false

# Logging
LOG_FILE_PATH=logs/system.log
LOG_MAX_SIZE_MB=100
LOG_BACKUP_COUNT=5