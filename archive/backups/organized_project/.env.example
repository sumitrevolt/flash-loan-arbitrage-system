# Flash Loan Arbitrage System - Environment Configuration
# Generated on 2025-06-19 19:05:55

# =============================================================================
# BLOCKCHAIN CONFIGURATION
# =============================================================================

# Network RPC URLs
POLYGON_RPC_URL=https://polygon-rpc.com
MUMBAI_RPC_URL=https://rpc-mumbai.maticvigil.com

# Private Keys (NEVER commit real keys to version control)
PRIVATE_KEY=your_private_key_here

# Contract Addresses
FLASH_LOAN_CONTRACT_ADDRESS=
AAVE_POOL_ADDRESS_PROVIDER=0xa97684ead0e402dC232d5A977953DF7ECBaB3CDb

# API Keys
POLYGONSCAN_API_KEY=your_polygonscan_api_key
COINMARKETCAP_API_KEY=your_cmc_api_key

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=flash_loan_arbitrage
DB_USER=postgres
DB_PASSWORD=your_db_password

# =============================================================================
# TRADING CONFIGURATION
# =============================================================================

# Risk Management
MIN_PROFIT_THRESHOLD_USD=5.0
MAX_TRADE_AMOUNT_USD=10000.0
MAX_GAS_PRICE_GWEI=50
SLIPPAGE_TOLERANCE_PERCENT=3.0

# Circuit Breaker
CIRCUIT_BREAKER_THRESHOLD=10

# Trading Mode
TRADING_MODE=simulation  # 'simulation' or 'live'
DRY_RUN_MODE=true

# =============================================================================
# MCP SERVER CONFIGURATION
# =============================================================================

# MCP Server Ports
MCP_PRICE_FEED_PORT=9001
MCP_TRANSACTION_PORT=9002
MCP_ARBITRAGE_PORT=9003

# =============================================================================
# LOGGING AND MONITORING
# =============================================================================

LOG_LEVEL=INFO
LOG_FILE=logs/flash_loan_arbitrage.log

# Monitoring
ENABLE_PROMETHEUS=false
PROMETHEUS_PORT=8080

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# GitHub Integration
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_REPO=

# AI Services
OPENAI_API_KEY=your-openai-api-key-here

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Development Settings
NODE_ENV=development
DEBUG=false

# Testing
REPORT_GAS=false
