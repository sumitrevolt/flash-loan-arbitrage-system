{
    "snyk.advanced.cliPath": "C:\\Users\\Ratanshila\\AppData\\Local\\snyk\\vscode-cli\\snyk-win.exe",
    "snyk.folderConfigs": [
        {
            "folderPath": "c:\\Users\\Ratanshila\\Documents\\flash loan",
            "baseBranch": ""
        }
    ],
    "snyk.trustedFolders": [
        "c:\\Users\\Ratanshila\\Documents\\flash loan"
    ],
    "CodeLLMs.proxy": "refactor",
    "CodeLLMs.defaultModel": "zhipu",
    "docker.extension.dockerEngineAvailabilityPrompt": false,
    "roo-cline.allowedCommands": [
        "npm test",
        "npm install",
        "tsc",
        "git log",
        "git diff",
        "git show"
    ],
    "snyk.yesWelcomeNotification": false,
    "snyk.allIssuesVsNetNewIssues": "All issues",
    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": false,
        "scminput": false,
        "sql": false
    },
    "python.defaultInterpreterPath": "c:\\Program Files\\Python311\\python.exe",
    "mcp": {
        "servers": {
            "github": {
                "command": "docker",
                "args": [
                    "run",
                    "-i",
                    "--rm",
                    "-e",
                    "GITHUB_PERSONAL_ACCESS_TOKEN",
                    "ghcr.io/github/github-mcp-server"
                ],
                "env": {
                    "GITHUB_PERSONAL_ACCESS_TOKEN": "${input:github_token}"
                }
            },
            "playwright": {
                "command": "npx",
                "args": [
                    "-y",
                    "@playwright/mcp@latest"
                ],
                "env": {
                    "DISPLAY": "${input:display}"
                }
            },
            "context7": {
                "command": "npx",
                "args": [
                    "-y",
                    "@upstash/context7-mcp"
                ],
                "env": {}
            },
            "filesystem": {
                "command": "npx",
                "args": [
                    "@modelcontextprotocol/server-filesystem",
                    "${input:allowedDirectory}",
                    "${input:workspaceDirectory}"
                ],
                "env": {}
            },
            "mcp-sequentialthinking-tools": {
                "command": "npx",
                "args": [
                    "-y",
                    "mcp-sequentialthinking-tools"
                ],
                "env": {}
            }
        },
        "inputs": [
            {
                "type": "promptString",
                "id": "github_token",
                "description": "GitHub Personal Access Token",
                "password": true
            },
            {
                "type": "promptString",
                "id": "display",
                "description": "Display server (e.g., :1)"
            },
            {
                "type": "promptString",
                "id": "display_env",
                "description": "The DISPLAY environment variable."
            },
            {
                "type": "promptString",
                "id": "allowedDirectory",
                "description": "Primary allowed directory for filesystem operations"
            },
            {
                "type": "promptString",
                "id": "workspaceDirectory",
                "description": "Additional workspace directory for filesystem operations"
            },
            {
                "type": "promptString",
                "id": "mondayApiToken",
                "description": "monday.com API token (personal access token)",
                "password": true
            },
            {
                "type": "promptString",
                "id": "dockerHost",
                "description": "Docker Host (leave blank for local or use ssh://user@host for remote connection)"
            }
        ]
    },
    "github.copilot.selectedCompletionModel": "",
    "Checkmarx AI Secure Coding Assistant (ASCA).Activate ASCA": true,
    "diffEditor.experimental.showMoves": true,
    "chat.agent.maxRequests": 50,
    "github.copilot.chat.agent.thinkingTool": true,
    "github.copilot.chat.codesearch.enabled": true,
    "chat.tools.autoApprove": true,
    "chat.mcp.discovery.enabled": true,
    "editor.largeFileOptimizations": false,
    "gocodeo.hasShownWalkthrough": true,
    "diffEditor.maxComputationTime": 0,
    "python.analysis.typeCheckingMode": "strict",
    "python.createEnvironment.trigger": "off",
    "dbcode.history.enabled": true,
    "yaml.schemas": {
        "c:\\Users\\Ratanshila\\.vscode\\extensions\\continue.continue-1.0.11-win32-x64\\config-yaml-schema.json": [
            ".continue/**/*.yaml"
        ]
    },
    "docker.extension.enableComposeLanguageServer": false,
    "containers.containerClient": "com.microsoft.visualstudio.containers.docker",
    "mcpServers": {},
    "codium.codeCompletion.enable": true,
    "chat.mcp.serverSampling": {
        "Global in Code: filesystem": {
            "allowedModels": [
                "github.copilot-chat/claude-opus-4",
                "github.copilot-chat/claude-3.5-sonnet",
                "github.copilot-chat/claude-3.7-sonnet",
                "github.copilot-chat/claude-3.7-sonnet-thought",
                "github.copilot-chat/gpt-4.1",
                "github.copilot-chat/claude-sonnet-4",
                "github.copilot-chat/gemini-2.0-flash-001",
                "github.copilot-chat/gemini-2.5-pro",
                "github.copilot-chat/gpt-4.5-preview",
                "github.copilot-chat/gpt-4o",
                "github.copilot-chat/o1",
                "github.copilot-chat/o3",
                "github.copilot-chat/o3-mini",
                "github.copilot-chat/o4-mini"
            ]
        }
    },
    "github.copilot.nextEditSuggestions.enabled": true,
    "gitlens.ai.model": "vscode",
    "gitlens.ai.vscode.model": "copilot:claude-sonnet-4"
}
