FROM python:3.11-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js for GitHub Copilot CLI
RUN curl -sL https://deb.nodesource.com/setup_18.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# Install GitHub Copilot CLI
RUN npm install -g @githubnext/github-copilot-cli

# Create app directory
WORKDIR /app

# Copy requirements and install Python dependencies
COPY containers/agents/requirements-agents.txt .
RUN pip install --no-cache-dir -r requirements-agents.txt

# Install AI and agent-specific dependencies
RUN pip install --no-cache-dir \
    openai>=1.0.0 \
    anthropic>=0.7.0 \
    langchain>=0.1.0 \
    langchain-openai>=0.0.5 \
    autogen-agentchat>=0.2.0 \
    redis>=5.0.0 \
    psycopg2-binary>=2.9.0 \
    fastapi>=0.104.0 \
    uvicorn>=0.24.0 \
    websockets>=12.0 \
    aiohttp>=3.9.0 \
    pydantic>=2.0.0 \
    structlog>=23.0.0 \
    prometheus-client>=0.19.0

# Copy agent code
COPY core/ai_agents /app/ai_agents
COPY core/coordinators /app/coordinators
COPY mcp_servers /app/mcp_servers

# Set up entrypoint script
RUN echo '#!/bin/bash\n\
set -e\n\
\n\
# Wait for Redis to be ready\n\
echo "Waiting for Redis..."\n\
while ! nc -z redis-cluster 6379; do\n\
  sleep 1\n\
done\n\
echo "Redis is ready!"\n\
\n\
# Wait for MCP servers to be ready\n\
echo "Waiting for MCP servers..."\n\
while ! nc -z mcp-servers-pro 8000; do\n\
  sleep 1\n\
done\n\
echo "MCP servers are ready!"\n\
\n\
# Set Python path\n\
export PYTHONPATH=/app:$PYTHONPATH\n\
\n\
# Start AI agents with GitHub integration\n\
echo "Starting AI Agents with GitHub Integration..."\n\
python ai_agents/enhanced_ai_system.py\n\
' > /app/entrypoint.sh

# Make entrypoint executable
RUN chmod +x /app/entrypoint.sh

# Install netcat for health checks
RUN apt-get update && apt-get install -y netcat-openbsd && rm -rf /var/lib/apt/lists/*

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

# Expose port
EXPOSE 8001

# Set entrypoint
ENTRYPOINT ["/app/entrypoint.sh"]
