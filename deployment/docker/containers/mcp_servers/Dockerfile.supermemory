# Supermemory MCP Server Docker Image
FROM python:3.11-slim

LABEL maintainer="Flash Loan Team"
LABEL description="Supermemory MCP Server for Universal Memory Management"
LABEL version="1.0.0"

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create working directory
WORKDIR /app

# Copy requirements and install Python dependencies
COPY mcp_servers/supermemory/requirements.txt .
RUN pip install --upgrade pip && \
    pip install -r requirements.txt

# Copy the MCP server code
COPY mcp_servers/supermemory/ .

# Create necessary directories
RUN mkdir -p /app/logs /app/data

# Expose port for health checks
EXPOSE 8100

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD python -c "import sys; sys.exit(0)"

# Run the MCP server
CMD ["python", "supermemory_mcp_server.py"]