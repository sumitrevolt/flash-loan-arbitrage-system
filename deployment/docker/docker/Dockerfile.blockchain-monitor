FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements/blockchain-monitor.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY src/blockchain/ ./blockchain/
COPY abi/ ./abi/

# Create entrypoint
COPY deployment/docker/docker/entrypoint-blockchain-monitor.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8070

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8070/health || exit 1

ENTRYPOINT ["/entrypoint.sh"] 