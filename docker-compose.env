# Docker Compose Environment Variables for Flash Loan Application

# Database Configuration
POSTGRES_DB=flash_loan_db
POSTGRES_USER=flash_loan_user
POSTGRES_PASSWORD=flash_loan_secure_2025
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PASSWORD=flash_loan_redis_2025
REDIS_PORT=6379

# Web3 Node Configuration
WEB3_NODE_PORT=8545
WEB3_WS_PORT=8546
WEB3_NODE_LOG_LEVEL=3

# ===========================================
# CURSOR API CONFIGURATION
# ===========================================
# IMPORTANT: Replace these with your actual Cursor API credentials
# Get your API key from: https://cursor.com/settings/api-keys
# If you don't have Cursor API access, set ENABLE_CURSOR_INTEGRATION=false

# Replace 'your_cursor_api_key_here' with your actual Cursor API key
CURSOR_API_KEY=your_cursor_api_key_here

# Optional: Set these if you have organization/project specific access
CURSOR_ORGANIZATION_ID=
CURSOR_PROJECT_ID=

# Cursor API Configuration (you can adjust these)
CURSOR_MODEL=cursor-gpt-4
CURSOR_BASE_URL=https://api.cursor.com/v1
CURSOR_TEMPERATURE=0.1
CURSOR_MAX_TOKENS=4096
CURSOR_TIMEOUT=30

# Toggle Cursor integration on/off
ENABLE_CURSOR_INTEGRATION=false

# ===========================================
# FALLBACK API KEYS
# ===========================================
# If Cursor API is not available, these will be used as fallbacks
# Replace with your actual API keys

# OpenAI API (fallback option)
OPENAI_API_KEY=your_openai_key_here

# Anthropic API (fallback option)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Google AI API (fallback option)
GOOGLE_API_KEY=your_google_key_here

# GitHub Token (for accessing repositories)
GITHUB_TOKEN=

# ===========================================
# LANGCHAIN & AUTOGEN CONFIGURATION
# ===========================================
# These use the Cursor API configuration above
LANGCHAIN_API_KEY=${CURSOR_API_KEY}
LANGCHAIN_MODEL=${CURSOR_MODEL}
LANGCHAIN_ENDPOINT=${CURSOR_BASE_URL}

AUTOGEN_API_KEY=${CURSOR_API_KEY}
AUTOGEN_MODEL=${CURSOR_MODEL}
AUTOGEN_ENDPOINT=${CURSOR_BASE_URL}
AUTOGEN_MAX_AGENTS=10

# ===========================================
# SERVICE CONFIGURATION
# ===========================================
LOG_LEVEL=INFO
ENABLE_REAL_EXECUTION=false
ENABLE_TESTING=true
ENABLE_MONITORING=true
ENABLE_DEBUG=false

# Service ports (adjust if needed)
LANGCHAIN_PORT=8000
AUTOGEN_PORT=8001
API_GATEWAY_PORT=8080

# ===========================================
# INSTRUCTIONS FOR SETUP
# ===========================================
# 1. Get your Cursor API key from https://cursor.com/settings/api-keys
# 2. Replace 'your_cursor_api_key_here' with your actual API key
# 3. If you don't have Cursor API access:
#    - Set ENABLE_CURSOR_INTEGRATION=false
#    - Add your OpenAI or Anthropic API key as fallback
# 4. Save this file and restart Docker containers: docker compose restart 